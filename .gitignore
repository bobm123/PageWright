# Generated output
output/
*.svg

# Saved .tiproj.json jobs: local working files. They reference
# source images by absolute path (and derived/imported pages still
# point into the temp dir), so they are not portable between
# machines and do not belong in the repo.
projects/

# Session transcripts and scratch notes: conversation artifacts,
# not project documentation. Design decisions belong in PLAN.md.
notes/

